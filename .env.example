# Copy this file to .env for local development.
# Never commit real secrets. Use separate values for local, test, staging, and production.

# App runtime
NODE_ENV=development
A8N_ENV_PROFILE=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_WEBHOOK_BASE_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://a8n_dev:a8n_dev@127.0.0.1:5432/a8n_dev

# Authentication
BETTER_AUTH_SECRET=replace-with-32-plus-character-local-secret
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Credential encryption
ENCRYPTION_KEY=replace-with-32-plus-character-local-secret

# Billing
POLAR_ACCESS_TOKEN=polar_oat_replace_with_sandbox_token
POLAR_SUCCESS_URL=http://localhost:3000/success?checkout_id={CHECKOUT_ID}
# sandbox | production. Production validation requires "production".
POLAR_SERVER=sandbox
POLAR_PRO_PRODUCT_ID=
POLAR_WEBHOOK_SECRET=

# Subscriptions & quotas (freemium model)
ENTITLEMENTS_ENABLED=false
ENTITLEMENTS_BETA_USER_IDS=
FREE_MAX_WORKFLOWS=5
FREE_MAX_CREDENTIALS=10
FREE_AGENT_CHATS_PER_MONTH=25
PRO_AGENT_CHATS_PER_MONTH=500
EXECUTIONS_DAILY_ABUSE_GUARD=100
BILLING_RECONCILE_SECRET=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Observability and release evidence
OBSERVABILITY_LOG_ENABLED=true
OBSERVABILITY_LOG_LEVEL=info
OBSERVABILITY_LOG_FORMAT=json
OBSERVABILITY_REDACTION_STRICT=true
OBSERVABILITY_INCLUDE_ERROR_STACK=false
OBSERVABILITY_CLIENT_LOG_ENABLED=true
OBSERVABILITY_REQUEST_BODY_LOG_ENABLED=false
OBSERVABILITY_SLOW_QUERY_MS=500
OBSERVABILITY_SAMPLE_DEBUG_RATE=0
OBSERVABILITY_PROVIDER=console
OBSERVABILITY_METRICS_ENDPOINT=
ERROR_TRACKING_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=a8n
OTEL_HEADERS=
ALERT_WEBHOOK_URL=
RELEASE_VERSION=
ROLLBACK_TARGET=

# Incident, disaster recovery, and performance operations
BACKUP_PROVIDER=
RESTORE_DRILL_TARGET=
BASE_URL=
API_LOAD_PATH=/api/mcp
WEBHOOK_LOAD_PATH=/api/webhooks/google-form
MCP_BEARER_TOKEN=
WORKFLOW_ID=

# Feature flags, canary rollout, experiments, and kill switches
FEATURE_FLAGS_ENABLED=true
FEATURE_FLAG_OVERRIDES=
FEATURE_FLAG_NEW_WORKFLOW_EDITOR_ROLLOUT_PERCENT=0
FEATURE_FLAG_API_CANARY_ROLLOUT_PERCENT=0
FEATURE_FLAG_MCP_ENHANCED_TOOLING_ROLLOUT_PERCENT=0
FEATURE_FLAG_EMBEDDED_AGENT_ROLLOUT_PERCENT=0
FEATURE_FLAG_EMBEDDED_AGENT_APPLY_ROLLOUT_PERCENT=0
FEATURE_FLAG_AGENT_LONG_TERM_MEMORY_ROLLOUT_PERCENT=0
FEATURE_FLAG_AGENT_PROVIDER_FALLBACK_ROLLOUT_PERCENT=0
FEATURE_FLAG_CREDENTIAL_ROTATION_FLOW_ROLLOUT_PERCENT=0
CANARY_ROLLOUT_PERCENT=0
EXPERIMENT_EVENT_LOG_ENABLED=true
EXPERIMENT_WORKFLOW_ONBOARDING_V2_VARIANT=
KILL_SWITCH_DISABLE_WORKFLOW_EXECUTION=false
KILL_SWITCH_DISABLE_WEBHOOK_PROCESSING=false
KILL_SWITCH_DISABLE_MCP_MUTATIONS=false
KILL_SWITCH_DISABLE_AGENT_RUNS=false
KILL_SWITCH_DISABLE_AGENT_MUTATIONS=false
KILL_SWITCH_READ_ONLY_MODE=false

# MCP server
MCP_AUDIT_LOG_ENABLED=true
MCP_AUDIT_DB_ENABLED=true
MCP_API_KEY_HMAC_SECRET=replace-with-32-plus-character-local-secret
MCP_OAUTH_TOKEN_HMAC_SECRET=replace-with-32-plus-character-local-secret
MCP_CORS_ORIGINS=http://localhost:3000
MCP_RATE_LIMIT_BACKEND=memory
MCP_SAFE_FETCH_ALLOWLIST_MODE=false
MCP_SAFE_FETCH_ALLOWLIST_DOMAINS=

# MCP OAuth
MCP_OAUTH_ISSUER=
MCP_OAUTH_RESOURCE=
MCP_OAUTH_REDIRECT_URIS=
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_ALLOW_DYNAMIC_CLIENT_REGISTRATION=
MCP_OAUTH_DYNAMIC_CLIENT_REGISTRATION_APPROVED=
MCP_OAUTH_ROTATE_REFRESH_TOKENS=true
MCP_OAUTH_EXACT_REDIRECT_URIS=
MCP_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
MCP_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
MCP_OAUTH_AUTH_CODE_TTL_SECONDS=600

# Webhooks
A8N_WEBHOOK_SHARED_SECRET=replace-with-local-webhook-secret
GOOGLE_FORM_WEBHOOK_SECRET=replace-with-local-google-form-secret
STRIPE_WEBHOOK_SECRET=whsec_replace_with_sandbox_secret
STRIPE_WEBHOOK_SHARED_SECRET=replace-with-local-stripe-shared-secret

# Cron and maintenance
CRON_SECRET=
MCP_MAINTENANCE_SECRET=
# Marks executions FAILED after 15 minutes stuck in RUNNING (falls back to CRON_SECRET)
EXECUTIONS_REAPER_SECRET=

# Embedded workflow agent
OPENAI_API_KEY=
AGENT_MODEL_PROVIDER=openai
AGENT_MODEL_NAME=gpt-4o-mini
AGENT_FALLBACK_MODEL_NAME=
AGENT_CHECKPOINT_SCHEMA=agent_graph
AGENT_MAX_STEPS=20
AGENT_RUN_TIMEOUT_MS=30000
AGENT_MAX_TOOL_CALLS=30
AGENT_TOOL_TIMEOUT_MS=15000
AGENT_MEMORY_TTL_DAYS=180
AGENT_EMBEDDING_MODEL=text-embedding-3-small
AGENT_EMBEDDING_DIMENSIONS=1536

# Local webhook/demo helpers
NGROK_URL=
NGROK_AUTHTOKEN=

# Hosted environment smoke targets
PREVIEW_URL=
STAGING_URL=

# E2E test-only flags. Keep false outside automated E2E.
E2E_TESTS=false
E2E_EXTERNAL_SERVICES=
